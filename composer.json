{
    "name": "corporateaid/recruit",
    "description": "Recruit Aid — Recruitment Operations & Applicant Tracking System",
    "type": "project",
    "license": "proprietary",
    "version": "0.6.0-alpha",
    "require": {
        "php": ">=8.2",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-fileinfo": "*",
        "ext-json": "*",
        "ext-ctype": "*",
        "ext-tokenizer": "*",
        "ext-dom": "*",
        "ext-gd": "*",
        "phpmailer/phpmailer": "^6.9",
        "dompdf/dompdf": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "CorporateAid\\Core\\":       "app/Core/",
            "CorporateAid\\Platform\\":   "app/Platform/",
            "CorporateAid\\Recruit\\":    "app/Recruit/",
            "CorporateAid\\Helpers\\":    "app/Helpers/"
        },
        "files": [
            "app/Helpers/functions.php"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "classmap-authoritative": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require-dev": {
        "phpstan/phpstan": "^2.3"
    }
}
