# Composer
/vendor/
composer.phar

# Environment & Secrets
.env
config/local.php
config/cli.php

# Storage (runtime files, never commit)
storage/logs/*
!storage/logs/.gitkeep
storage/uploads/*
!storage/uploads/.htaccess
!storage/uploads/.gitkeep
storage/cache/*
!storage/cache/.gitkeep
storage/tmp/*
!storage/tmp/.gitkeep
storage/backups/*
!storage/backups/.gitkeep

# Diagnostic / Debug files
debug.php
debug_logger.php
phpstan_errors.txt
public/.htaccess.tmp
php_native_errors.log

# OS / IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# PHPStan
phpstan-baseline.neon

# Accidentally-redirected shell output files (names end with commas, parens, etc.)
[0-9]*,
*()
*.bak.*
phpstan_raw.txt

# Backup files from prior sessions (safety copies; recoverable from git history)
*.bak
*.debug-backup
*.pre_*.bak

# Schema dumps (regenerate via bin/migrate.php + SHOW CREATE TABLE)
db_schema*.sql

# PHPUnit caches and vendored phar (use composer's phpunit)
.phpunit.cache/
tools/phpunit/*.phar

# Old test artifacts that predate git history
tests/*.debug-backup
tests/*.pre_*.bak
/tmp/
phpstan-raw-*.txt
